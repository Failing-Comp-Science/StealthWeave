# ─── Harpocrates .gitignore ─────────────────────────────────
# Rules for what is SAFE to push. Anything matching below stays local only.

# ── External reference repos (NOT pushed; licensed separately, credited in README) ──
# These are third-party clones studied for algorithm ideas. See README.md for credit.
# Because they carry their own .git + upstream remotes, they are excluded wholesale.
references/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
build/
wheels/

# ── Node / frontend ───────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnpm-store/
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
*.tsbuildinfo
out-tsc/
coverage/
.turbo/
vite.config.ts.*timestamp*
# build output
dist/
**/dist/
tmp/
out-tsc/

# ── Secrets & local config (NEVER commit) ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.pkcs12
credentials.json
serviceAccountKey.json
secrets.json

# ── Replit —───────────────────────────────────────────────────────────
.replit-artifact/
.ReplitState/
.cache/
.local/

# ── OS / editor ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.DS_Store?
._.DS_Store
Ehthumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.cursor/

# ── Logs ─────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Misc ─────────────────────────────────────────────────────────────
/connect.lock
/libpeerconnection.log